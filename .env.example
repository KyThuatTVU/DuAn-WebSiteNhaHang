# ==============================================
# DOCKER ENVIRONMENT CONFIGURATION
# ==============================================
# Copy this file to .env and update the values

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
# Docker MySQL will be exposed on port 3307 to avoid conflict with local MySQL
DB_HOST=database
DB_PORT=3307
DB_NAME=QuanLyNhaHang
DB_USER=nhahang_user
DB_PASSWORD=nhahang_password
DB_ROOT_PASSWORD=TVU@842004

# ==============================================
# APPLICATION PORTS
# ==============================================
# Backend API port (default: 3000)
BACKEND_PORT=3000

# Frontend web server port (default: 80 for production, 8080 for dev)
FRONTEND_PORT=80

# phpMyAdmin port (development only)
PHPMYADMIN_PORT=8081

# ==============================================
# JWT AUTHENTICATION
# ==============================================
# Change this to a strong secret key in production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# ==============================================
# AI SERVICES (Optional)
# ==============================================
# Google Generative AI API Key
GOOGLE_AI_API_KEY=your-google-ai-api-key

# Groq API Key
GROQ_API_KEY=your-groq-api-key

# ==============================================
# NODE.JS ENVIRONMENT
# ==============================================
NODE_ENV=production

# ==============================================
# LOGGING CONFIGURATION
# ==============================================
LOG_LEVEL=info

# ==============================================
# SECURITY SETTINGS
# ==============================================
# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:80,http://localhost:8080

# Rate limiting (requests per minute)
RATE_LIMIT=100

# ==============================================
# FILE UPLOAD SETTINGS
# ==============================================
# Maximum file size for uploads (in MB)
MAX_FILE_SIZE=10

# Allowed file types for uploads
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,webp

# ==============================================
# DEVELOPMENT SETTINGS
# ==============================================
# Set to true to enable debug mode
DEBUG=false

# Set to true to enable API documentation
ENABLE_SWAGGER=true
