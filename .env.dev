# ==============================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION
# Restaurant Management System
# ==============================================

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
DB_HOST=database
DB_PORT=3307
DB_NAME=QuanLyNhaHang
DB_USER=nhahang_user
DB_PASSWORD=nhahang_dev_password
DB_ROOT_PASSWORD=TVU@842004

# ==============================================
# APPLICATION PORTS (Development)
# ==============================================
# Backend API port
BACKEND_PORT=3000

# Frontend web server port (development)
FRONTEND_PORT=8080

# phpMyAdmin port
PHPMYADMIN_PORT=8081

# ==============================================
# JWT AUTHENTICATION (Development)
# ==============================================
JWT_SECRET=dev-jwt-secret-key-not-for-production
JWT_EXPIRES_IN=24h

# ==============================================
# AI SERVICES (From existing config)
# ==============================================
# Google Generative AI API Key (Gemini 2.0 Flash)
GOOGLE_AI_API_KEY=AIzaSyDIFJyixG2eQL_xCu1-nDXWET_yVOUspzE
GEMINI_API_KEY=AIzaSyDIFJyixG2eQL_xCu1-nDXWET_yVOUspzE

# Groq API Key
GROQ_API_KEY=your-actual-groq-api-key

# ==============================================
# NODE.JS ENVIRONMENT
# ==============================================
NODE_ENV=development

# ==============================================
# LOGGING CONFIGURATION
# ==============================================
LOG_LEVEL=debug

# ==============================================
# SECURITY SETTINGS (Development)
# ==============================================
# CORS allowed origins (more permissive for development)
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://127.0.0.1:8080,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500

# Rate limiting (more permissive for development)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# ==============================================
# FILE UPLOAD SETTINGS
# ==============================================
# Maximum file size for uploads (10MB for development)
MAX_FILE_SIZE=10485760

# Allowed file types for uploads
ALLOWED_FILE_TYPES=image/jpeg,image/jpg,image/png,image/gif,image/webp

# ==============================================
# DEVELOPMENT SETTINGS
# ==============================================
# Enable debug mode
DEBUG=true

# Enable API documentation
ENABLE_SWAGGER=true
