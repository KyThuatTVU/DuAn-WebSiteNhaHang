# 🍽️ Restaurant Management System - Docker Environment Configuration
# Copy this file to .env and customize the values

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DB_HOST=mysql
DB_PORT=3306
DB_USER=restaurant_user
DB_PASSWORD=restaurant_pass_2024
DB_NAME=QuanLyNhaHang
DB_ROOT_PASSWORD=restaurant_root_123

# ===========================================
# SERVER CONFIGURATION
# ===========================================
NODE_ENV=production
API_PORT=3000
WEB_PORT=80
WEB_SSL_PORT=443

# ===========================================
# JWT AUTHENTICATION
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-2024
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production-2024
JWT_EXPIRE=1h
JWT_REFRESH_EXPIRE=7d

# ===========================================
# AI SERVICES (OPTIONAL)
# ===========================================
# Get your API keys from:
# Gemini: https://ai.google.dev/
# Groq: https://console.groq.com/
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# ===========================================
# REDIS CACHE (OPTIONAL)
# ===========================================
REDIS_PORT=6379
REDIS_PASSWORD=

# ===========================================
# FILE UPLOAD CONFIGURATION
# ===========================================
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./images

# ===========================================
# EMAIL CONFIGURATION (OPTIONAL)
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ===========================================
# SECURITY CONFIGURATION
# ===========================================
CORS_ORIGIN=*
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# ===========================================
# OPTIONAL SERVICES PORTS
# ===========================================
PHPMYADMIN_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_PASSWORD=admin123

# ===========================================
# SSL CONFIGURATION (OPTIONAL)
# ===========================================
SSL_CERT_PATH=./docker/ssl/cert.pem
SSL_KEY_PATH=./docker/ssl/key.pem

# ===========================================
# BACKUP CONFIGURATION
# ===========================================
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=7
BACKUP_PATH=./backups

# ===========================================
# LOGGING CONFIGURATION
# ===========================================
LOG_LEVEL=info
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# ===========================================
# DEVELOPMENT OVERRIDES
# ===========================================
# Uncomment for development mode
# NODE_ENV=development
# API_PORT=3000
# WEB_PORT=8080
# DB_HOST=localhost
