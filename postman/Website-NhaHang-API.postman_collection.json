						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}",
								"disabled": true
							}
						],
						"url": {
							"raw": "{{baseUrl}}/categories/1",
							"host": ["{{baseUrl}}"],
							"path": ["categories", "1"]
						}
					},
					"response": []
				}
			]
		},
		{
