{
	"info": {
		"_postman_id": "restaurant-api-collection",
		"name": "Website Nhà Hàng - API Collection",
		"description": "Complete API collection for Restaurant Management System\n\n## Features:\n- Health checks and system endpoints\n- Food and category management\n- Customer authentication\n- Booking management (đặt bàn)\n- AI Chat integration\n- File upload support\n\n## Base URL:\n- Local: http://localhost:3000/api\n- Docker: http://localhost:3000/api\n\n## Authentication:\nSome endpoints require JWT token in Authorization header:\n`Bearer <your-jwt-token>`",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "🏥 Health & System",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/health",
							"host": ["{{baseUrl}}"],
							"path": ["health"]
						}
					},
					"response": []
