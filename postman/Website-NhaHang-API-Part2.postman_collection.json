						"body": {
							"mode": "raw",
							"raw": "{\n  \"ten_khach\": \"Nguyễn Văn A (Updated)\",\n  \"sdt\": \"0987654321\",\n  \"email\": \"nguyenvana@email.com\",\n  \"ngay\": \"2024-12-25\",\n  \"gio\": \"20:00:00\",\n  \"so_luong_khach\": 6,\n  \"ghi_chu\": \"Bàn VIP\",\n  \"trang_thai\": \"da_xac_nhan\"\n}"
