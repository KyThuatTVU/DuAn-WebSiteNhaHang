							"mode": "raw",
							"raw": "{\n  \"ten_khach\": \"Nguyễn Văn A\",\n  \"sdt\": \"0987654321\",\n  \"email\": \"nguyenvana@email.com\",\n  \"ngay\": \"2024-12-25\",\n  \"gio\": \"19:00:00\",\n  \"so_luong_khach\": 4,\n  \"ghi_chu\": \"Bàn gần cửa sổ\"\n}"
