{
	"info": {
		"_postman_id": "restaurant-api-part2",
		"name": "Website Nhà Hàng - API Collection Part 2",
		"description": "Authentication, Booking, and Chat endpoints",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "🔐 Authentication",
			"item": [
				{
					"name": "Register Customer",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"ho_ten\": \"Nguyễn Văn Test\",\n  \"email\": \"test@example.com\",\n  \"mat_khau\": \"password123\",\n  \"so_dien_thoai\": \"0987654321\",\n  \"dia_chi\": \"123 Test Street, TP.HCM\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/khach_hang/register",
							"host": ["{{baseUrl}}"],
							"path": ["khach_hang", "register"]
						}
					},
					"response": []
				},
				{
					"name": "Login Customer",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Extract and save auth token",
									"if (pm.response.json().token) {",
									"    pm.globals.set('authToken', pm.response.json().token);",
									"    console.log('Auth token saved:', pm.response.json().token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/khach_hang/login",
							"host": ["{{baseUrl}}"],
							"path": ["khach_hang", "login"]
						}
					},
					"response": []
				},
				{
					"name": "Get User Profile",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/khach_hang/profile",
							"host": ["{{baseUrl}}"],
							"path": ["khach_hang", "profile"]
						}
					},
					"response": []
				},
				{
					"name": "Refresh Token",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/khach_hang/refresh",
							"host": ["{{baseUrl}}"],
							"path": ["khach_hang", "refresh"]
						}
					},
					"response": []
				}
			]
		},
